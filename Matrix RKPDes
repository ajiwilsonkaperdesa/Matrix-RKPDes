<script>
  const kamusSDGsData = [
    { kode: "1.1.01", nama: "Penyediaan Penghasilan Tetap dan Tunjangan Kepala Desa", bidang: 1, satuan: "Bulan" },
    { kode: "1.1.02", nama: "Penyediaan Penghasilan Tetap dan Tunjangan Perangkat Desa", bidang: 1, satuan: "Bulan" },
    { kode: "1.1.03", nama: "Penyediaan Operasional Pemerintah Desa (Siltap, ATK, dll)", bidang: 1, satuan: "Tahun" },
    { kode: "1.2.01", nama: "Penyelenggaraan Musyawarah Desa (Musdes/Musrenbangdes)", bidang: 1, satuan: "Kegiatan" },
    { kode: "2.1.01", nama: "Pembangunan/Rehabilitasi/Peningkatan Jalan Desa", bidang: 2, satuan: "Meter" },
    { kode: "2.1.02", nama: "Pembangunan/Rehabilitasi/Peningkatan Jembatan Desa", bidang: 2, satuan: "Unit" },
    { kode: "2.2.01", nama: "Penyelenggaraan Posyandu Kesehatan Masyarakat (Makanan Tambahan, dll)", bidang: 2, satuan: "Paket" },
    { kode: "3.1.01", nama: "Pembinaan Group Kesenian dan Kebudayaan Tingkat Desa", bidang: 3, satuan: "Kelompok" },
    { kode: "3.2.01", nama: "Penguatan & Pelatihan Satuan Pelindungan Masyarakat (Satlinmas)", bidang: 3, satuan: "Orang" },
    { kode: "4.1.01", nama: "Pelatihan & Bantuan Modal Usaha Bumdesa / Kelompok Tani", bidang: 4, satuan: "Paket" },
    { kode: "5.1.01", nama: "Penanganan Keadaan Darurat / Bencana Alam", bidang: 5, satuan: "Kegiatan" },
    { kode: "5.2.01", nama: "Penanganan Keadaan Mendesak (BLT Desa)", bidang: 5, satuan: "KPM" }
  ];

  function autoDetectData(val) {
    let text = val.toLowerCase();
    let satInp = document.getElementById("inp_vol_satuan");
    
    if (text.includes("siltap") || text.includes("tunjangan") || text.includes("insentif") || text.includes("honor")) {
      satInp.value = "Bulan";
    } else if (text.includes("jalan") || text.includes("drainase") || text.includes("irigasi") || text.includes("rabat")) {
      satInp.value = "Meter";
    } else if (text.includes("posyandu") || text.includes("pelatihan") || text.includes("makanan tambahan") || text.includes("stunting")) {
      satInp.value = "Paket";
    } else if (text.includes("musdes") || text.includes("musrenbang") || text.includes("pembinaan") || text.includes("bencana")) {
      satInp.value = "Kegiatan";
    } else if (text.includes("blt") || text.includes("bantuan")) {
      satInp.value = "KPM";
    }
  }

  function hitungInputManual() {
    let vol = parseFloat(document.getElementById("inp_vol_jumlah").value) || 0;
    let harga = parseFloat(document.getElementById("inp_harga_satuan").value) || 0;
    document.getElementById("inp_total_biaya").value = vol * harga;
  }

  function tambahKegiatanManual() {
    let b = document.getElementById("inp_bidang_target").value;
    let kode = document.getElementById("inp_kode").value || "-";
    let nama = document.getElementById("inp_nama").value || "Kegiatan Baru";
    let vol = parseFloat(document.getElementById("inp_vol_jumlah").value) || 1;
    let satuan = document.getElementById("inp_vol_satuan").value || "Paket";
    let harga = parseFloat(document.getElementById("inp_harga_satuan").value) || 0;

    tambahBarisTabel(b, kode, nama, vol, satuan, harga);
    
    document.getElementById("inp_kode").value = "";
    document.getElementById("inp_nama").value = "";
    document.getElementById("inp_harga_satuan").value = "0";
    document.getElementById("inp_total_biaya").value = "0";

    simpanDataKeStorage();
  }

  function tambahBarisTabel(bidang, kode, nama, vol, satuan, harga) {
    let tbody = document.getElementById(`body_bidang_${bidang}`);
    let rowCount = tbody.children.length + 1;
    let total = vol * harga;

    let tr = document.createElement("tr");
    tr.innerHTML = `
      <td class="text-center row-no">${rowCount}</td>
      <td contenteditable="true" onkeyup="simpanDataKeStorage()">${kode}</td>
      <td contenteditable="true" onkeyup="simpanDataKeStorage()">${nama}</td>
      <td contenteditable="true" class="text-center cell-vol" onblur="rehitungBaris(this)">${vol}</td>
      <td contenteditable="true" class="text-center" onkeyup="simpanDataKeStorage()">${satuan}</td>
      <td contenteditable="true" class="text-right cell-harga" onblur="rehitungBaris(this)">${harga.toLocaleString('id-ID')}</td>
      <td class="text-right cell-total" data-value="${total}">Rp ${total.toLocaleString('id-ID')}</td>
      <td class="text-center no-print"><button class="btn-danger" style="padding: 2px 6px;" onclick="hapusBaris(this)">X</button></td>
    `;
    tbody.appendChild(tr);
    simpanDanHitung();
  }

  function rehitungBaris(el) {
    let tr = el.closest("tr");
    let volText = tr.querySelector(".cell-vol").innerText.replace(/\./g, '').replace(',', '.');
    let hargaText = tr.querySelector(".cell-harga").innerText.replace(/[^0-9]/g, '');

    let vol = parseFloat(volText) || 0;
    let harga = parseFloat(hargaText) || 0;
    let total = vol * harga;

    tr.querySelector(".cell-harga").innerText = harga.toLocaleString('id-ID');
    let cellTotal = tr.querySelector(".cell-total");
    cellTotal.setAttribute("data-value", total);
    cellTotal.innerText = "Rp " + total.toLocaleString('id-ID');

    simpanDanHitung();
  }

  function hapusBaris(btn) {
    let tr = btn.closest("tr");
    let tbody = tr.closest("tbody");
    tr.remove();
    
    Array.from(tbody.children).forEach((row, idx) => {
      row.querySelector(".row-no").innerText = idx + 1;
    });

    simpanDanHitung();
  }

  function simpanDanHitung() {
    hitungkanTotal();
    simpanDataKeStorage();
  }

  function hitungkanTotal() {
    let paguIndikatif = parseFloat(document.getElementById("inp_pagu").value) || 0;
    let grandTotal = 0;

    for (let i = 1; i <= 5; i++) {
      let totalBidang = 0;
      let rows = document.querySelectorAll(`#body_bidang_${i} tr`);
      
      rows.forEach(row => {
        let cellTotal = row.querySelector(".cell-total");
        if (cellTotal) {
          totalBidang += parseFloat(cellTotal.getAttribute("data-value") || 0);
        }
      });

      document.getElementById(`subtotal_bidang_${i}`).innerText = "Rp " + totalBidang.toLocaleString('id-ID');
      grandTotal += totalBidang;
    }

    let sisa = paguIndikatif - grandTotal;
    document.getElementById("inp_total_alokasi").value = "Rp " + grandTotal.toLocaleString('id-ID');
    document.getElementById("inp_sisa_pagu").value = "Rp " + sisa.toLocaleString('id-ID');
    
    let elSisa = document.getElementById("inp_sisa_pagu");
    if (sisa < 0) {
      elSisa.style.color = "#ff4d4d";
    } else {
      elSisa.style.color = "#2ecc71";
    }
  }

  /* =========================================================
     3. FITUR PENYIMPANAN OTOMATIS (LOCAL STORAGE) & TAHUN
     ========================================================= */
  function getStorageKey() {
    let tahun = document.getElementById("inp_tahun").value;
    return `rkp_desa_kaduagung_${tahun}`;
  }

  function gantiTahun() {
    let tahun = document.getElementById("inp_tahun").value;
    document.getElementById("txt_tahun_judul").innerText = tahun;
    document.getElementById("txt_tahun_ttd").innerText = tahun;
    muatDataDariStorage();
  }

  function simpanDataKeStorage() {
    let tahun = document.getElementById("inp_tahun").value;
    let pagu = document.getElementById("inp_pagu").value;
    let dataBidang = {};

    for (let i = 1; i <= 5; i++) {
      dataBidang[i] = [];
      let rows = document.querySelectorAll(`#body_bidang_${i} tr`);
      rows.forEach(row => {
        let cols = row.querySelectorAll("td");
        if (cols.length >= 7) {
          dataBidang[i].push({
            kode: cols[1].innerText.trim(),
            nama: cols[2].innerText.trim(),
            vol: cols[3].innerText.trim(),
            satuan: cols[4].innerText.trim(),
            harga: cols[5].innerText.replace(/[^0-9]/g, '')
          });
        }
      });
    }

    let payload = {
      pagu: pagu,
      bidang: dataBidang
    };

    localStorage.setItem(getStorageKey(), JSON.stringify(payload));
  }

  function muatDataDariStorage() {
    let saved = localStorage.getItem(getStorageKey());
    
    for (let i = 1; i <= 5; i++) {
      document.getElementById(`body_bidang_${i}`).innerHTML = "";
    }

    if (!saved) {
      loadDefaultStandard();
      return;
    }

    let parsed = JSON.parse(saved);
    document.getElementById("inp_pagu").value = parsed.pagu || 827799193;

    for (let i = 1; i <= 5; i++) {
      if (parsed.bidang && parsed.bidang[i]) {
        parsed.bidang[i].forEach(item => {
          tambahBarisTabel(i, item.kode, item.nama, parseFloat(item.vol) || 0, item.satuan, parseFloat(item.harga) || 0);
        });
      }
    }
    hitungkanTotal();
  }

  function resetKeDefault() {
    if (confirm("Apakah Anda yakin ingin mengembalikan data tahun ini ke setelan awal default? Data yang ditambahkan manual akan terhapus.")) {
      localStorage.removeItem(getStorageKey());
      muatDataDariStorage();
    }
  }

  function loadDefaultStandard() {
    for (let i = 1; i <= 5; i++) {
      document.getElementById(`body_bidang_${i}`).innerHTML = "";
    }

    tambahBarisTabel(1, "1.1.01", "Penyediaan Penghasilan Tetap dan Tunjangan Kepala Desa", 12, "Bulan", 3500000);
    tambahBarisTabel(1, "1.1.02", "Penyediaan Penghasilan Tetap dan Tunjangan Perangkat Desa", 12, "Bulan", 2500000);
    tambahBarisTabel(1, "1.2.01", "Penyelenggaraan Musyawarah Desa (Musrenbangdes)", 2, "Kegiatan", 5000000);

    tambahBarisTabel(2, "2.1.01", "Pembangunan Jalan Usaha Tani / Rabat Beton", 250, "Meter", 450000);
    tambahBarisTabel(2, "2.2.01", "Penyelenggaraan Posyandu & Pemberian Makanan Tambahan (PMT)", 12, "Paket", 3500000);

    tambahBarisTabel(3, "3.1.01", "Pembinaan Group Kesenian dan Kebudayaan Desa", 1, "Kelompok", 10000000);
    tambahBarisTabel(3, "3.2.01", "Pelatihan & Pelindungan Masyarakat (Satlinmas)", 15, "Orang", 500000);

    tambahBarisTabel(4, "4.1.01", "Pelatihan Penguatan Modal Usaha BUMDes", 1, "Paket", 25000000);

    tambahBarisTabel(5, "5.2.01", "Penanganan Keadaan Mendesak (BLT Desa)", 20, "KPM", 3600000);

    simpanDanHitung();
  }

  function bukaKamus() {
    document.getElementById("modalKamus").style.display = "flex";
    renderKamus(kamusSDGsData);
  }

  function tutupKamus() {
    document.getElementById("modalKamus").style.display = "none";
  }

  function renderKamus(data) {
    let container = document.getElementById("kamus_list");
    container.innerHTML = "";
    data.forEach(item => {
      let div = document.createElement("div");
      div.style.cssText = "padding: 10px; border-bottom: 1px solid #444; display: flex; justify-content: space-between; align-items: center;";
      div.innerHTML = `
        <div>
          <strong>[${item.kode}]</strong> ${item.nama} <br>
          <small style="color: #aaa;">Bidang: ${item.bidang} | Satuan Default: ${item.satuan}</small>
        </div>
        <button class="btn-success" style="padding: 4px 8px;" onclick="pilihDariKamus('${item.kode}', '${item.nama}', ${item.bidang}, '${item.satuan}')">Gunakan</button>
      `;
      container.appendChild(div);
    });
  }

  function filterKamus() {
    let query = document.getElementById("inp_filter_kamus").value.toLowerCase();
    let filtered = kamusSDGsData.filter(i => i.nama.toLowerCase().includes(query) || i.kode.includes(query));
    renderKamus(filtered);
  }

  function pilihDariKamus(kode, nama, bidang, satuan) {
    document.getElementById("inp_bidang_target").value = bidang;
    document.getElementById("inp_kode").value = kode;
    document.getElementById("inp_nama").value = nama;
    document.getElementById("inp_vol_satuan").value = satuan;
    tutupKamus();
  }

  window.onload = function() {
    muatDataDariStorage();
  };
</script>

